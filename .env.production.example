# ThreatScope — public personal site production profile
# Copy to .env on your VPS. NEVER commit .env to Git.

ENV=production
THREATSCOPE_PUBLIC=1

# Required
SECRET_KEY=
ALLOWED_HOSTS=threatscope.example.com

# Real client IPs behind Nginx (see deploy/nginx/threatscope.conf)
TRUST_PROXY_HEADERS=1

# Public rate limits (slowapi format)
PUBLIC_RATE_LIMIT=20/minute
PUBLIC_FILE_UPLOAD_RATE_LIMIT=5/hour
PUBLIC_BLOCKLIST_RATE_LIMIT=5/hour

# Admin session (Intel tab + feed accuracy when logged in)
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Optional: admin session may enable dynamic sandbox on file upload (still needs worker + backend)
# ADMIN_ALLOW_DYNAMIC=0
# Or plaintext for initial setup only (prefer hash above):
# ADMIN_PASSWORD=

# Disabled on public internet — use cron on server instead
THREATSCOPE_ADMIN=0
INTEL_COLLECTION_ENABLED=0
LAB_SCAN_ENABLED=0
SANDBOX_BACKEND=off

OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_MAX_CONCURRENT=3
SUMMARY_CACHE_TTL=3600

MAX_UPLOAD_BYTES=33554432
HOST=127.0.0.1
PORT=8000
