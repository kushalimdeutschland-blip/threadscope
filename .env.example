# ─────────────────────────────────────────────────────────────────
# ThreatScope — Environment Configuration
# Copy to .env and customize. NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────

# development | production
ENV=development

# Required in production — generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated hostnames your VPS will answer to (production only)
# ALLOWED_HOSTS=threatscope.yourdomain.com,localhost

# Rate limit per client IP (slowapi format)
RATE_LIMIT=30/minute

# Ollama — MUST stay on localhost; never expose port 11434 publicly
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_CONCURRENT=3
SUMMARY_CACHE_TTL=3600

# Max request body for form POSTs (bytes)
MAX_BODY_BYTES=4096

# Max upload size for .exe / .apk static analysis (bytes, default 32MB)
MAX_UPLOAD_BYTES=33554432
FILE_UPLOAD_RATE_LIMIT=10/hour
SANDBOX_DYNAMIC_RATE_LIMIT=5/hour

# YARA rules on disk (not in SQLite) — run: python ingest_yara_rules.py
# YARA_RULES_DIR=data/yara_rules
# YARA_RULES_BUNDLE_URL=https://github.com/Yara-Rules/rules/archive/refs/heads/master.zip

# Dynamic sandbox — homelab: mobsf or auto for APK; mock for dev without Docker
SANDBOX_BACKEND=auto
MOBSF_URL=http://127.0.0.1:8001
MOBSF_API_KEY=
CAPE_URL=http://127.0.0.1:8002
CAPE_API_TOKEN=
SANDBOX_MAX_CONCURRENT=1
SANDBOX_JOB_TIMEOUT=600
SANDBOX_MOCK_DELAY=6
SANDBOX_POLL_INTERVAL=3
# Custom dynamic backend — see docs/dev/custom-sandbox.md
# SANDBOX_BACKEND=script
# SANDBOX_SCRIPT=/opt/threatscope/scripts/example_sandbox_analyzer.py

# Intel collection — paste/leak APIs + clear-web RSS (out-of-process; IOC-only for leaks)
# INTEL_COLLECTION_ENABLED=1
# INTELX_API_KEY=
# PASTEBIN_API_KEY=
# DEHASHED_API_KEY=
# DEHASHED_API_EMAIL=
# INTEL_WORKER_INTERVAL=3600
# INTEL_MAX_BODY_BYTES=32768
# INTEL_SCRAPE_RESPECT_ROBOTS=1
# INTEL_SCRAPE_DELAY_SECONDS=2
# INTEL_LIST_SNIPPET_CHARS=240
# INTEL_LIST_BODY_CHARS=4000
# Public personal site (stricter limits, no history for visitors)
# THREATSCOPE_PUBLIC=1
# TRUST_PROXY_HEADERS=1   # default on when ENV=production
# PUBLIC_RATE_LIMIT=20/minute
# PUBLIC_FILE_UPLOAD_RATE_LIMIT=5/hour
# PUBLIC_BLOCKLIST_RATE_LIMIT=5/hour

# Admin: session login (production) or dev bypass
# ADMIN_PASSWORD=          # plaintext — never commit
# ADMIN_PASSWORD_HASH=     # bcrypt — preferred in production
# THREATSCOPE_ADMIN=1      # dev only: Intel tab without login (ignored when THREATSCOPE_PUBLIC=1)
# ADMIN_ALLOW_DYNAMIC=1    # with THREATSCOPE_PUBLIC=1: signed-in admin may opt into dynamic sandbox

# Lab sample hash ingest (ingest_samples.py) — credentials never in git
# SAMPLE_REPO_ACME_PASSWORD=

# Intel AI (local Ollama; sanitized text only — master off keeps ingest fast)
# INTEL_AI_ENABLED=1
# INTEL_AI_INGEST_SUMMARY=1
# INTEL_AI_LOOKUP_CONTEXT=1
# INTEL_AI_QUERY_EXPAND=1
# INTEL_AI_MAX_BODY_CHARS=4096

# Opt-in lab nmap/ping — off by default; button on IP/domain lookup results only
# LAB_SCAN_ENABLED=1
# Run web app and worker with the same flag:
#   LAB_SCAN_ENABLED=1 ./scripts/dev.sh
#   LAB_SCAN_ENABLED=1 python scripts/scan_worker.py
